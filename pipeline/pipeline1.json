{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "OracleSource",
						"oracleReaderQuery": "select * from dbo.xyz",
						"partitionOption": "None",
						"numberPrecision": 38,
						"numberScale": 18,
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "OracleTable2",
						"type": "DatasetReference",
						"parameters": {
							"oracle_secret": {
								"value": "@pipeline().parameters.oracle_secret",
								"type": "Expression"
							},
							"user": {
								"value": "@pipeline().parameters.user",
								"type": "Expression"
							},
							"oracle_server": {
								"value": "@pipeline().parameters.oracle_server",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DelimitedText2",
						"type": "DatasetReference"
					}
				]
			}
		],
		"parameters": {
			"oracle_secret": {
				"type": "string",
				"defaultValue": "oracle-talendodss"
			},
			"user": {
				"type": "string",
				"defaultValue": "TALEND_ODS"
			},
			"oracle_server": {
				"type": "string",
				"defaultValue": "talend-db1-dev.ssc.tsc:1521/DTALEND1.ssc"
			},
			"sw_account": {
				"type": "string",
				"defaultValue": "tractorsupply.east-us-2.azure"
			}
		},
		"annotations": [],
		"lastPublishTime": "2025-10-29T15:31:20Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}