{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "fztestfactoryeus2"
		},
		"Oracle1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Oracle1'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://fzteststorage2.dfs.core.windows.net/"
		},
		"Oracle1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "dsgfjiyjdgfhgf"
		},
		"Oracle1_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "fzainab"
		},
		"integrationRuntime1_properties_typeProperties_linkedInfo_resourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/7baf12ad-7966-45d1-a4f3-7afe85124941/resourcegroups/fzrg/providers/Microsoft.DataFactory/factories/testADFfz/integrationruntimes/SHIR-IR"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "fztestfactoryeus2_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Oracle1_password": {
						"value": "[parameters('Oracle1_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"integrationRuntime1_properties_typeProperties_linkedInfo_resourceId": {
						"value": "[parameters('integrationRuntime1_properties_typeProperties_linkedInfo_resourceId')]"
					},
					"Oracle1_properties_typeProperties_server": {
						"value": "[parameters('Oracle1_properties_typeProperties_server')]"
					},
					"Oracle1_properties_typeProperties_username": {
						"value": "[parameters('Oracle1_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}